# Panel de Partners de Tiendanube
TIENDANUBE_CLIENT_ID=TU_CLIENT_ID_AQUI
TIENDANUBE_CLIENT_SECRET=TU_CLIENT_SECRET_AQUI

# URL pública del backend en Railway (sin barra final)
APP_URL=https://TU-APP.up.railway.app

# Orígenes permitidos para CORS (separados por coma). Usá * para permitir todos.
FRONTEND_URL=*

# Opcional: token fijo para una tienda (útil si no querés depender de OAuth en memoria)
# TN_STORE_ID=7793118
# TN_ACCESS_TOKEN=token_de_springdemo

# Varias tiendas en JSON (persiste mejor que stores.json en Railway)
# TN_STORES_JSON={"7793118":"token_springdemo","6125057":"token_spring29"}

# Script del Partner Portal a asociar tras instalar la app
# TN_SCRIPT_ID=7169

# Secret para POST /auth/register-token (registro manual de token)
# INSTALL_SECRET=elige-un-secret-largo

# Railway asigna PORT automáticamente
PORT=3000
